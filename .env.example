# Copy this file to .env and fill in your values.
# Never commit your real .env file or your API key.

# Get a free key from Google AI Studio. Leave empty to use demo mode.
GEMINI_API_KEY=

# Gemini model name used for reasoning and vision
GEMINI_MODEL=gemini-2.5-flash

# SQLite database location (leave empty to use farm.db in this folder)
DATABASE_URL=

# Maximum photo upload size in megabytes
MAX_UPLOAD_MB=5

# Comma-separated list of frontend addresses allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
